{
  // HISTORICAL: the ailardi-arcade Worker router (src/index.mjs) is retained
  // for reference only. Live traffic is served by Cloudflare Pages projects
  // directly (see AGENTS.md), so this config deliberately defines no routes:
  // attaching it to a domain would shadow the live ailardi.com Pages site.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ailardi-arcade",
  "main": "src/index.mjs",
  "compatibility_date": "2026-06-18",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
