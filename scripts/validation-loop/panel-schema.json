{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation level persona panel",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "iteration", "levelId", "personas", "summary"],
  "properties": {
    "slug": { "type": "string" },
    "iteration": { "type": "integer" },
    "levelId": { "type": "integer" },
    "personas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "playedMinutes", "difficulty", "viewport", "fun", "clarity", "fairness", "keepPlaying", "likes", "gripes", "issues"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["kid-casual", "teen-regular", "adult-casual", "adult-veteran"]
          },
          "playedMinutes": { "type": "number", "exclusiveMinimum": 0 },
          "difficulty": { "type": "string" },
          "viewport": { "type": "string" },
          "fun": { "type": "integer", "minimum": 1, "maximum": 5 },
          "clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
          "fairness": { "type": "integer", "minimum": 1, "maximum": 5 },
          "keepPlaying": { "type": "string", "enum": ["yes", "maybe", "no"] },
          "likes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "gripes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["severity", "description"],
              "properties": {
                "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
